# Twilio Video credentials (required for all examples)
# From https://console.twilio.com — Account SID + an API Key/Secret pair.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# OpenAI — only needed for examples/voice_agent.js
OPENAI_API_KEY=
# Realtime model to use (optional; defaults to gpt-realtime-2.1 if unset).
# Other options include gpt-realtime-2.1-mini (cheaper/faster) and gpt-realtime.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
