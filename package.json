{
  "name": "twilio-video-sdk",
  "version": "0.1.0",
  "description": "Twilio Video Media Streams SDK for Node.js - Server-side access to decoded video/audio frames",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "install": "node scripts/install.js",
    "build": "cmake-js build",
    "build:debug": "cmake-js build --debug",
    "build:release": "cmake-js build --CDRTC_CPP_BUILD_TYPE=release",
    "rebuild": "cmake-js rebuild",
    "clean": "cmake-js clean",
    "prebuild": "node scripts/prebuild.js",
    "upload": "node scripts/upload.js",
    "upload:darwin": "node scripts/upload.js darwin-x64",
    "upload:linux": "node scripts/upload.js linux-x64",
    "fetch-deps": "node scripts/fetch-deps.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit.test.js",
    "test:integration": "vitest run test/integration.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cmake-js": "^7.3.0",
    "node-addon-api": "^8.0.0",
    "twilio": "^5.12.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "lib",
    "scripts/install.js",
    "scripts/common.js",
    "package.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "keywords": [
    "twilio",
    "video",
    "webrtc",
    "media-streams",
    "real-time"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://code.hq.twilio.com/client/twilio-video-node.git"
  }
}
