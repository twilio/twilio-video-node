{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The root config sets rootDir to lib/; these files live outside it.
    "rootDir": ".",
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "types": ["node"],
    "lib": ["ES2023"],
    // The examples are plain JS. Requiring every local to be annotated would be
    // noise; this check exists to catch calls into the SDK that no longer
    // exist, which needs only the SDK-typed values to stay typed.
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["**/*.js"],
  // The computer-vision examples import onnxruntime-node and @napi-rs/canvas,
  // which live in examples/package.json and are installed only by developers
  // running them (see the README). They are syntax-checked by `check:examples`
  // instead.
  "exclude": [
    "cv_object_detection.js",
    "cv_face_analysis.js",
    "helpers/cv-runner.js",
    "helpers/cv-postprocess.js",
    "helpers/draw.js",
    "helpers/onnx-model.js"
  ]
}
