{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["lib/index.ts"],
  "tsconfig": "./tsconfig.json",
  "out": "docs",
  "projectDocuments": [
    "FRAME_CONTRACT.md",
    "LIFECYCLE.md",
    "SECURITY-PRIVACY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE.md",
    "examples/README.md"
  ],
  "name": "@twilio/video-node-sdk",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "treatWarningsAsErrors": true,
  "navigationLinks": {
    "GitHub": "https://github.com/twilio/twilio-video-node",
    "Twilio Video": "https://www.twilio.com/docs/video"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  }
}
